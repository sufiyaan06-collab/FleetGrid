{
  "name": "fleetgrid-server",
  "version": "0.1.0",
  "private": true,
  "description": "FleetGrid authoritative backend (Express + TypeScript + PostgreSQL, with local JSON fallback)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit false",
    "serve": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx test/auth-security.test.ts && tsx test/flow.test.ts && tsx test/auth-integration.test.ts",
    "reset": "node ../scripts/reset.mjs",
    "provision:ops": "tsx scripts/provision-ops.ts",
    "migrate:postgres": "tsx scripts/migrate-json-to-postgres.ts",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "inspect:legacy": "tsx scripts/inspect-legacy-postgres.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dodopayments": "^2.52.0",
    "express": "^4.19.2",
    "fleetgrid-root": "file:../..",
    "ws": "^8.18.0",
    "zod": "^3.23.8",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "@types/pg": "^8.11.10"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
